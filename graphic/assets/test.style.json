{
  "type": "stylesheet",
  "namespace": "demo",
  "styles": {
    "root": {
      "default": {
        "border-width": 0,
        "margin": 0,
        "height": 1080,
        "width": 1920
      }
    },
    "header": {
      "default": {
        "height": 100,
        "width": 1920,
        "background-color": "#1f4d1fff"
      }
    },
    "menu-bar": {
      "default": {
        "height": 35,
        "horizontal-sizing": "grow",
        "stack": "horizontal",
        "background-color": "#28292fff"
      }
    },
    "menu-bar-item": {
      "default": {
        "width": 70,
        "height": 35,
        "padding": 8,
        "font-size": 15,
        "text-color": "#e7e7e7ff",
        "text-wrap": "none",
        "padding-left": 20
      },
      "hovered": {
        "background-color": "#3d3d3dff"
      }
    },
    "list-view": {
      "default": {
        "vertical-sizing": "grow",
        "width": 350,
        "stack": "vertical",
        "background-color": "#262626ff",
        "padding": 5,
        "padding-left": 10,
        "border-width": 0,
        "border-color": "#d3d3d3ff",
        "handle-scroll": "true"
      }
    },
    "list-item": {
      "default": {
        "vertical-sizing": "fit",
        "horizontal-sizing": "grow",
        "padding": 0,
        "margin-top": 4
      }
    },
    "list-item-label": {
      "default": {
        "horizontal-sizing": "grow",
        "vertical-sizing": "fit",
        "font-size": 16,
        "padding-top": 4,
        "padding-bottom": 4,
        "padding-left": 10,
        "text-color": "#ffffffbc",
        "text-wrap": "none",
        "border-width": 2,
        "border-radius": 4,
        "padding": 3
      },
      "hovered": {
        "text-color": "#ffffffff",
        "background-color": "#2b64cdff"
      },
      "selected": {
        "text-color": "#ffffffff",
        "background-color": "#4981f11a",
        "border-width": 2,
        "border-color": "#5485e8b9",
        "border-radius": 4
      },
      "hovered|selected": {
        "text-color": "#ffffffff",
        "background-color": "#2b64cdff",
        "border-width": 2,
        "border-color": "#5485e8b9",
        "border-radius": 4
      }
    },
    "sub-item-container": {
      "default": {
        "vertical-sizing": "fit",
        "horizontal-sizing": "grow",
        "stack": "vertical",
        "padding-left": 5,
        "padding-top": 0,
        "margin-left": 10,
        "border-width": [0, 0, 0, 1],
        "border-color": "#ffffff20"
      }
    },
    "inspector-panel": {
      "default": {
        "stack": "vertical",
        "vertical-sizing": "fit",
        "horizontal-sizing": "grow",
        "background-color": "#383838ff",
        "padding": 0
      }
    },
    "inspector-header": {
      "default": {
        "stack": "horizontal",
        "height": 36,
        "horizontal-sizing": "grow",
        "padding": [8, 12],
        "background-color": "#3c3c3cff",
        "border-width": [0, 0, 1, 0],
        "border-color": "#2a2a2aff"
      }
    },
    "component-section": {
      "default": {
        "stack": "vertical",
        "horizontal-sizing": "grow",
        "vertical-sizing": "fit",
        "margin-bottom": 2
      }
    },
    "component-header": {
      "default": {
        "stack": "horizontal",
        "height": 24,
        "horizontal-sizing": "grow",
        "padding": [4, 8],
        "background-color": "#474747ff",
        "font-size": 13,
        "text-color": "#e0e0e0ff"
      },
      "hovered": {
        "background-color": "#505050ff"
      }
    },
    "component-toggle": {
      "default": {
        "width": 20,
        "text-color": "#8cf48cff",
        "font-size": 14
      }
    },
    "component-menu-button": {
      "default": {
        "width": 20,
        "text-color": "#888888ff",
        "font-size": 14
      },
      "hovered": {
        "text-color": "#ffffffff"
      }
    },
    "component-body": {
      "default": {
        "stack": "vertical",
        "horizontal-sizing": "grow",
        "vertical-sizing": "fit",
        "padding": [8, 16],
        "background-color": "#3c3c3cff"
      }
    },
    "collapse-arrow": {
      "default": {
        "width": 20,
        "font-size": 10,
        "text-color": "#888888ff"
      }
    },
    "section-header": {
      "default": {
        "stack": "horizontal",
        "height": 22,
        "horizontal-sizing": "grow",
        "padding": [4, 8],
        "background-color": "#505050ff",
        "font-size": 12,
        "text-color": "#c8c8c8ff"
      }
    },
    "section-body": {
      "default": {
        "stack": "vertical",
        "horizontal-sizing": "grow",
        "vertical-sizing": "fit",
        "padding": 8,
        "background-color": "#3c3c3cff"
      }
    },
    "field-row": {
      "default": {
        "stack": "horizontal",
        "height": 22,
        "horizontal-sizing": "grow",
        "margin-bottom": 4
      }
    },
    "field-label": {
      "default": {
        "width": 120,
        "font-size": 12,
        "text-color": "#a0a0a0ff",
        "padding-top": 3
      }
    },
    "field-value": {
      "default": {
        "horizontal-sizing": "grow",
        "height": 20,
        "font-size": 12,
        "text-color": "#e0e0e0ff",
        "background-color": "#2a2a2aff",
        "padding": [3, 6],
        "border-radius": 2
      },
      "hovered": {
        "background-color": "#333333ff"
      }
    },
    "field-vec3": {
      "default": {
        "stack": "horizontal",
        "height": 22,
        "horizontal-sizing": "grow",
        "margin-bottom": 4
      }
    },
    "vec3-input": {
      "default": {
        "stack": "horizontal",
        "horizontal-sizing": "grow"
      }
    },
    "axis-input": {
      "default": {
        "stack": "horizontal",
        "horizontal-sizing": "grow",
        "height": 20,
        "margin-right": 4,
        "background-color": "#2a2a2aff",
        "border-radius": 2
      }
    },
    "field-slider": {
      "default": {
        "stack": "horizontal",
        "height": 22,
        "horizontal-sizing": "grow",
        "margin-bottom": 4
      }
    },
    "slider-track": {
      "default": {
        "stack": "horizontal",
        "horizontal-sizing": "grow",
        "height": 18,
        "background-color": "#2a2a2aff",
        "border-radius": 2
      }
    },
    "slider-fill": {
      "default": {
        "width": 60,
        "height": 18,
        "background-color": "#5a8dd8ff",
        "border-radius": 2
      }
    },
    "slider-value-label": {
      "default": {
        "horizontal-sizing": "grow",
        "font-size": 11,
        "text-color": "#c0c0c0ff",
        "padding": [2, 6]
      }
    },
    "field-checkbox": {
      "default": {
        "stack": "horizontal",
        "height": 22,
        "horizontal-sizing": "grow",
        "margin-bottom": 4
      }
    },
    "checkbox-box": {
      "default": {
        "width": 18,
        "height": 18,
        "font-size": 14,
        "text-color": "#8cf48cff",
        "background-color": "#2a2a2aff",
        "border-radius": 2
      },
      "hovered": {
        "background-color": "#3a3a3aff"
      }
    },
    "field-dropdown": {
      "default": {
        "stack": "horizontal",
        "height": 22,
        "horizontal-sizing": "grow",
        "margin-bottom": 4
      }
    },
    "dropdown-button": {
      "default": {
        "stack": "horizontal",
        "horizontal-sizing": "grow",
        "height": 20,
        "padding": [3, 8],
        "font-size": 12,
        "text-color": "#e0e0e0ff",
        "background-color": "#4a4a4aff",
        "border-radius": 2
      },
      "hovered": {
        "background-color": "#555555ff"
      }
    },
    "field-color": {
      "default": {
        "stack": "horizontal",
        "height": 22,
        "horizontal-sizing": "grow",
        "margin-bottom": 4
      }
    },
    "color-swatch": {
      "default": {
        "width": 50,
        "height": 18,
        "background-color": "#3498dbff",
        "border-radius": 2,
        "border-width": 1,
        "border-color": "#1a1a1aff"
      },
      "hovered": {
        "border-color": "#666666ff"
      }
    },
    "field-asset": {
      "default": {
        "stack": "horizontal",
        "height": 22,
        "horizontal-sizing": "grow",
        "margin-bottom": 4
      }
    },
    "asset-picker": {
      "default": {
        "stack": "horizontal",
        "horizontal-sizing": "grow",
        "height": 20,
        "padding": [2, 6],
        "font-size": 12,
        "text-color": "#a0c8ffff",
        "background-color": "#2a2a2aff",
        "border-radius": 2
      },
      "hovered": {
        "background-color": "#333333ff"
      }
    },
    "asset-thumbnail": {
      "default": {
        "width": 16,
        "height": 16,
        "background-color": "#555555ff",
        "margin-right": 6
      }
    },
    "asset-picker-button": {
      "default": {
        "width": 20,
        "font-size": 12,
        "text-color": "#888888ff"
      },
      "hovered": {
        "text-color": "#ffffffff"
      }
    },
    "add-component-button": {
      "default": {
        "height": 28,
        "horizontal-sizing": "grow",
        "margin": [12, 24],
        "padding": 6,
        "font-size": 13,
        "text-color": "#d0d0d0ff",
        "background-color": "#4a4a4aff",
        "border-radius": 3
      },
      "hovered": {
        "background-color": "#5a5a5aff"
      }
    }
  }
}
